{
  "info": {
    "_postman_id": "27650d53-6372-435f-b67f-a87ce1b286d4",
    "name": "SIS Portal - Diagnostic Imaging Today",
    "description": "API xác thực và truy vấn danh sách bệnh nhân chẩn đoán hình ảnh trong ngày",
